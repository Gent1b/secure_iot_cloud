      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"iot_data\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"water_pipeline\")\n  |> filter(fn: (r) => r[\"_field\"] == \"leak_flag\")\n  |> filter(fn: (r) => r[\"site_id\"] == \"${site}\")\n  |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: false)\n  |> yield(name: \"leak_flag\")",
          "refId": "A"
        }
      ],
      "title": "1. LEAK FLAG (Cause - Application)",
      "type": "timeseries"
    },

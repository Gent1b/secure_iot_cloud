###############################
# Grafana Admin Credentials
###############################
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin123

###############################
# InfluxDB Datasource Settings
###############################
# Use internal IP for cross-VM communication
INFLUXDB_URL=http://172.31.33.61:8086

# Security token (must match cloud.env)
INFLUXDB_TOKEN=local_token_123

# InfluxDB organization & bucket (must match cloud.env)
INFLUXDB_ORG=secure_iot
INFLUXDB_BUCKET=iot_data

# Prometheus
PROMETHEUS_URL=http://prometheus:9090
